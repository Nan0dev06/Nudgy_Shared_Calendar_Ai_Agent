# Copy this file to `.env` and fill in the blanks. `.env` is git-ignored, so real
# secrets never get committed. Only GOOGLE_CLIENT_ID is public — everything else
# here is a credential; keep it in `.env` only, never paste it into chats/PRs.

# --- Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials) ---
# Create an OAuth client of type "Web application" and add these redirect URIs:
#   http://localhost:8000/auth/google/callback   (the web app)
#   http://localhost:8765/                        (optional CLI connect scripts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- App secrets ---
# SECRET_KEY signs the login cookie; TOKEN_ENCRYPTION_KEY (a Fernet key) encrypts
# stored OAuth tokens at rest. Locally both can stay unset (SECRET_KEY falls back
# to a dev default; the token key derives from it). In production SET BOTH to
# stable random values, or logins break and stored tokens stop decrypting.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_KEY=
# TOKEN_ENCRYPTION_KEY=

# --- LLM provider for the Nudgy agent ---
# The agent speaks the OpenAI chat API, so any OpenAI-compatible provider works.
# Recommended free option: Groq (fast, no credit card): https://console.groq.com/keys
LLM_PROVIDER=groq            # groq | openai | ollama
GROQ_API_KEY=
# Free limits are org-wide; the daily token budget is what matters:
#   llama-3.1-8b-instant     -> 500K tokens/day  (default; biggest budget, weaker at tools)
#   llama-3.3-70b-versatile  -> 100K tokens/day  (smarter at tools; fewer turns/day)
NUDGY_MODEL=llama-3.1-8b-instant

# Other OpenAI-compatible providers: uncomment and set LLM_BASE_URL + LLM_API_KEY.
# Heads-up: a provider with a small free-tier context cap (e.g. 8K) or a very low
# requests/min limit can choke the multi-step tool loop — check before switching.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# NUDGY_MODEL=gpt-4o-mini

# --- Database (optional) ---
# Unset -> local SQLite file (nudgy.db). Set to a Postgres URL in production.
# DATABASE_URL=
